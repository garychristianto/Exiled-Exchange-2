{
  "_README": "Mechanics spec = INPUT #2 of three (1: mod pool from poe2db; 2: currency/omen behavior = THIS FILE; 3: prices from the trade API). poe2db does NOT contain this; it is game-logic, sourced from patch notes / wiki / datamine. Each entry maps to one craftsim Action: the engine reads `operations` to build the transition and `price_key` to cost it. Fill numeric/pool specifics and flip `verified:true` once confirmed against the live patch. `null` + `verify` = must be pinned from data.",

  "_schema": {
    "id": "stable key, also the craftsim action name",
    "name": "in-game name",
    "price_key": "key into the prices table (input #3)",
    "applies_to_rarity": "subset of [normal, magic, rare]",
    "precondition": {"min_mods": "int|null", "needs_open_slot": "bool|null", "note": "free text"},
    "operations": "ordered list; each transforms the item. Vocabulary below.",
    "omen_compatible": "ids of omens that legally modify this action",
    "verified": "true only when shape AND numbers confirmed against current patch",
    "notes": "what still needs verifying"
  },

  "_operation_vocabulary": {
    "set_rarity": {"to": "magic|rare"},
    "add": {
      "slot": "any|prefix|suffix",
      "count": "int",
      "pool": "full | tier_floor | group:<family> | desecrated:<bone_tier>",
      "tier_floor": "int|null  (min modifier level when pool=tier_floor; THIS is what Greater/Perfect set)",
      "value_random": "bool (rolled value is random within the chosen tier's range)"
    },
    "remove": {"select": "random|lowest|highest|chosen", "count": "int", "respect_fracture": "bool"},
    "reroll_values": {"scope": "all|chosen", "respect_fracture": "bool"},
    "lock": {"select": "random|chosen|lowest", "count": "int", "note": "fracture: which mod becomes immune to remove/reroll"},
    "corrupt": {"note": "terminal; outcomes per patch"}
  },

